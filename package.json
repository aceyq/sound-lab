{
  "name": "frequency-playground",
  "private": true,
  "version": "1.0.0",
  "description": "Educational sound apps: Frequency Playground (additive synthesis from typed frequencies) and Motion Score (phone motion sensors control a laptop synthesizer); Vowel Morph and a camera Pose Sound Map.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "predev:phone": "node scripts/copy-mediapipe.mjs",
    "dev:phone": "vite --mode phone",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "vite": "5.4.21"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "peerjs": "1.5.5",
    "qrcode": "1.5.4"
  }
}
